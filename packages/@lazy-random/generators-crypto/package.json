{
  "name": "@lazy-random/generators-crypto",
  "version": "2.0.1",
  "description": "以加密安全亂數來源 (Cryptographically Secure RNG) 實作的亂數產生器 (Random Number Generator)，適合需要較高不可預測性 (Entropy) 的场合",
  "keywords": [
    "crypto",
    "cryptographically-secure",
    "entropy",
    "generator",
    "generators-crypto",
    "prng",
    "random",
    "random-number-generator",
    "rng",
    "secure-random",
    "create-by-yarn-tool",
    "create-by-tsdx"
  ],
  "homepage": "https://github.com/bluelovers/ws-random/tree/master/packages/@lazy-random/generators-crypto#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-random/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-random.git",
    "directory": "packages/@lazy-random/generators-crypto"
  },
  "license": "ISC",
  "author": "bluelovers",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.esm.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.esm.mjs",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "scripts": {
    "coverage": "pnpm run test -- --coverage",
    "lint": "ynpx --quiet eslint -- **/*.ts",
    "test": "echo jest --passWithNoTests",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:snapshot": "pnpm run test -- -u",
    "test:tsd": "ynpx tsd",
    "test:tsdx": "ynpx @bluelovers/tsdx test --passWithNoTests",
    "posttest": "pnpm run build",
    "build": "pnpm run build:tsdx && pnpm run build:dts",
    "build:dts": "copy .\\src\\index.d.ts .\\dist\\index.d.ts & echo build:dts",
    "build:tsdx": "ynpx @bluelovers/tsdx build --target node --name index",
    "preversion": "echo preversion && pnpm run test",
    "version": "echo version",
    "postversion": "echo postversion",
    "prepublish": "echo prepublish",
    "prepublishOnly": "echo prepublishOnly",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "publish": "echo publish",
    "postpublish": "echo postpublish",
    "postpublishOnly": "echo postpublishOnly",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@lazy-num/float-from-buffer": "^2.0.1",
    "@lazy-random/array-rand-index": "^2.0.1",
    "@lazy-random/cross-crypto": "^2.0.1",
    "@lazy-random/expect": "^2.0.1",
    "@lazy-random/rng-abstract": "^2.0.1",
    "@lazy-random/shared-lib": "^2.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "9d8e7456192d483519e8eff7bc45a72152bcf3c0"
}
