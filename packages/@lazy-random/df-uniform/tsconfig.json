{
  "extends": "@bluelovers/tsconfig/tsdx/index.json",
  "compilerOptions": {
    "importHelpers": true,
    "noImplicitAny": false,
    "noUnusedParameters": false,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "moduleResolution": "bundler",
    "rootDir": "src",
    "types": [
      "node"
    ]
  },
  "exclude": [
    "dist",
    "test"
  ]
}
