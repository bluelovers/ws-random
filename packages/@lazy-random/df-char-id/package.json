{
  "name": "@lazy-random/df-char-id",
  "version": "1.0.15",
  "description": "以自訂字元表 (Alphabet) 產生隨機字串 ID 的取樣函式 (Random Sampling Function)，屬 @lazy-random 系列的分佈函式 (Distribution Function) 套件",
  "keywords": [
    "df-char-id",
    "char-id",
    "random-string",
    "string",
    "id",
    "alphabet",
    "token",
    "invite-code",
    "short-url",
    "nanoid",
    "prng",
    "rng",
    "random",
    "lazy-random",
    "create-by-yarn-tool",
    "create-by-tsdx"
  ],
  "homepage": "https://github.com/bluelovers/ws-random/tree/master/packages/@lazy-random/df-char-id#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-random/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-random.git",
    "directory": "packages/@lazy-random/df-char-id"
  },
  "license": "ISC",
  "author": "bluelovers",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.esm.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.esm.mjs",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "scripts": {
    "coverage": "pnpm run test -- --coverage",
    "lint": "ynpx --quiet eslint -- **/*.ts",
    "test": "echo jest --passWithNoTests",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:mocha": "ynpx --quiet -p ts-node -p mocha mocha -- --require ts-node/register \"!(node_modules)/**/*.{test,spec}.{ts,tsx}\"",
    "test:snapshot": "pnpm run test -- -u",
    "test:tsd": "ynpx tsd",
    "test:tsdx": "ynpx @bluelovers/tsdx test --passWithNoTests",
    "posttest": "pnpm run build",
    "build": "pnpm run build:tsdx && pnpm run build:dts",
    "build:dts": "ynpx @bluelovers/dts-bundle-generator -o ./dist/index.d.ts ./src/index.ts --no-banner & echo build:dts",
    "build:tsdx": "ynpx @bluelovers/tsdx build --target node --name index",
    "preversion": "echo preversion && pnpm run test",
    "version": "echo version",
    "postversion": "echo postversion",
    "prepublish": "echo prepublish",
    "prepublishOnly": "echo prepublishOnly",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "publish": "echo publish",
    "postpublish": "echo postpublish",
    "postpublishOnly": "echo postpublishOnly",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@lazy-num/float-to-string": "^1.0.11",
    "@lazy-random/expect": "^1.0.15",
    "@lazy-random/shared-lib": "^1.0.15",
    "@lazy-random/util-distributions": "^1.0.10",
    "uni-string": "^2.0.10"
  },
  "devDependencies": {
    "@lazy-random/rng-abstract": "^1.0.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
