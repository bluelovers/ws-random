{
  "name": "random-extra",
  "version": "6.0.0",
  "description": "Seedable random number generator supporting many common distributions.",
  "keywords": [
    "alea",
    "arr",
    "array",
    "bates",
    "d3-random",
    "distribution",
    "el",
    "element",
    "exponential",
    "fisher",
    "gaussian",
    "generate",
    "generate-random-numbers",
    "generator",
    "irwinhall",
    "item",
    "list",
    "lognormal",
    "math",
    "n-random-numbers",
    "normal",
    "number",
    "numbers",
    "pick",
    "poisson",
    "prng",
    "probability",
    "pseudorandom",
    "rand",
    "random",
    "random-extra",
    "random-sum",
    "randomize",
    "randomnumbers",
    "rng",
    "seed",
    "seedable",
    "seedrandom",
    "select",
    "shuffle",
    "sort",
    "srand",
    "stats",
    "sum",
    "tychei",
    "uniform",
    "uuid",
    "weight",
    "weighted",
    "xor128",
    "xor4096",
    "xorshift7",
    "xorwow",
    "yates",
    "create-by-yarn-tool"
  ],
  "homepage": "https://github.com/bluelovers/ws-random/tree/master/packages/random-extra#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-random/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-random.git",
    "directory": "packages/random-extra"
  },
  "license": "MIT",
  "author": "Travis Fischer <travis@automagical.ai>",
  "main": "index.js",
  "types": "./index.d.ts",
  "typings": "./index.d.ts",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "coverage": "pnpm run test -- --coverage",
    "pretest_": "pnpm run build",
    "test": "dotenv -v NODE_OPTIONS=--experimental-vm-modules -- jest --maxConcurrency=1 --maxWorkers=1",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "pnpm run test:jest -- --coverage",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:snapshot": "pnpm run test -- -u",
    "test:tsd": "ynpx tsd",
    "posttest_": "git commit -m \"build: update seed\" ./src/util/random-seed-str.data.* & echo posttest",
    "build_": "pnpm run build:tsc",
    "build:index": "ts-node ./test/script/build-cache.ts",
    "build-minify": "ts-node ./test/script/minify",
    "build:tsc": "tsc",
    "postbuild_": "ynpx build-ts-file -- ../@lazy-random/seed-data/src/random-seed-str.data.ts && git add ./src/util/random-seed-str.data.ts ./src/util/random-seed-str.data.js",
    "preversion": "pnpm run test",
    "version": "echo version",
    "postversion": "echo postversion",
    "prepublish": "pnpm run postpublishOnly:add",
    "prepublishOnly": "echo prepublishOnly",
    "prepublishOnly:check-bin": "ynpx --quiet @yarn-tool/check-pkg-bin",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "publish": "echo publish",
    "postpublish": "echo postpublish",
    "postpublishOnly": "echo postpublishOnly",
    "postpublishOnly:add": "pnpm -w run postpublishOnly:add random-extra",
    "benchmark": "ts-node ./test/benchmark/simple.perf.ts && ts-node ./test/benchmark/base.perf.ts && ts-node ./test/benchmark/random-id.perf.ts",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@lazy-random/clone-class": "^2.0.0",
    "@lazy-random/cross-crypto": "^2.0.0",
    "@lazy-random/expect": "^2.0.0",
    "@lazy-random/generators-seedrandom": "^2.0.0",
    "@lazy-random/random-core": "^3.0.0",
    "@lazy-random/rng-abstract": "^2.0.0",
    "@lazy-random/rng-factory": "^2.0.0",
    "core-decorators": "^0.20.0",
    "num-is-zero": "^2.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@lazy-assert/check-basic": "^1.0.14",
    "@lazy-num/sum": "^2.0.0",
    "@lazy-random/array-algorithm": "^2.0.0",
    "@lazy-random/original-math-random": "^2.0.0",
    "@lazy-random/seed-token": "^2.0.0",
    "@lazy-random/simple-wrap": "^2.0.0"
  },
  "gitHead": "e61d528c84bd3340a59f288f65d20bfb2906c905"
}
