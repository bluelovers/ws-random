{
  "name": "ws-random",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "alea",
    "arr",
    "array",
    "bates",
    "d3-random",
    "distribution",
    "el",
    "element",
    "exponential",
    "fisher",
    "gaussian",
    "generate",
    "generate-random-numbers",
    "generator",
    "irwinhall",
    "item",
    "list",
    "lognormal",
    "math",
    "n-random-numbers",
    "normal",
    "number",
    "numbers",
    "pick",
    "poisson",
    "prng",
    "probability",
    "pseudorandom",
    "rand",
    "random",
    "random-extra",
    "random-sum",
    "randomSum",
    "randomize",
    "randomnumbers",
    "rng",
    "seed",
    "seedrandom",
    "select",
    "shuffle",
    "sort",
    "srand",
    "stats",
    "sum",
    "tychei",
    "uniform",
    "uuid",
    "weight",
    "weighted",
    "xor128",
    "xor4096",
    "xorshift7",
    "xorwow",
    "yates",
    "create-by-yarn-tool"
  ],
  "homepage": "https://github.com/bluelovers/ws-random#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-random/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-random.git"
  },
  "workspaces": [
    "packages/*",
    "packages/@lazy-random/*",
    "packages/@lazy-num/*"
  ],
  "scripts": {
    "test": "pnpm run test:since",
    "test:all": "dotenv --override -- yarn-tool ws run test --concurrency 1",
    "test:jest:clearCache": "jest --clearCache",
    "test:since": "pnpm run test:all --since",
    "test:snapshot:all": "yarn-tool ws run test:snapshot --concurrency 1",
    "test:snapshot:since": "pnpm run test:snapshot:all --since",
    "test:tsd:all": "yarn-tool ws run test:tsd --concurrency 1",
    "test:tsd:since": "pnpm run test:tsd:all --since",
    "install:frozenLockfile": "yarn-tool install --frozen-lockfile",
    "install:reset-lockfile": "yarn-tool install --reset-lockfile",
    "install:resetLockfile": "yarn-tool install --reset-lockfile",
    "build:all": "yarn-tool ws run build --concurrency 1",
    "build:since": "pnpm run build:all -- --since",
    "ci:install": "pnpm install --frozen-lockfile && pnpm add -w yarn-tool lerna ynpx ts-node ts-jest jest typescript@next @bluelovers/jest-config",
    "ci:install:pnpm": "pnpm install --frozen-lockfile && pnpm add --workspace yarn-tool lerna ynpx pnpm typescript ts-node tsx ts-jest jest @bluelovers/jest-config @bluelovers/tsconfig @yarn-tool/require-resolve",
    "ci:install:yarn": "pnpm install --frozen-lockfile && pnpm add -w yarn-tool lerna ynpx pnpm typescript ts-node tsx ts-jest jest @bluelovers/jest-config @bluelovers/tsconfig @yarn-tool/require-resolve",
    "ci:build": "echo ci:build",
    "lerna:publish": "pnpm run prepublishOnly:root && lerna publish && pnpm run postpublishOnly",
    "lerna:publish:yes": "pnpm run prepublishOnly:root && lerna publish --yes --bump patch && pnpm run postpublishOnly",
    "lerna:publish:yes:force": "lerna publish --no-private --yes --bump patch --force-publish",
    "lerna:publish:yes:major": "pnpm run prepublishOnly:root && lerna publish --no-private --yes --bump major && pnpm run postpublishOnly",
    "lerna:publish:yes:minor": "pnpm run prepublishOnly:root && lerna publish --no-private --yes --bump minor && pnpm run postpublishOnly",
    "lerna:publish:yes:patch": "pnpm run prepublishOnly:root && lerna publish --no-private --yes --bump patch && pnpm run postpublishOnly",
    "ws:fix-all": "yarn-tool fix-all  --overwriteHostedGitInfo",
    "ws:fix-all:resetStaticFiles": "pnpm run ws:fix-all -- --resetStaticFiles",
    "preversion": "tsx script/run/del-src-js.ts",
    "version": "echo version",
    "prepublish": "echo prepublish",
    "prepare": "echo prepare",
    "prepare:fix-ws-links": "echo skip fix-ws-links (yarn-only)",
    "prepublishOnly": "echo prepublishOnly",
    "prepublishOnly:check-bin": "ynpx --quiet @yarn-tool/check-pkg-bin",
    "prepublishOnly:lockfile": "ynpx --quiet sync-lockfile",
    "prepublishOnly:root": "pnpm run prepublishOnly:check-bin",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "prepack": "echo prepack",
    "pack": "echo pack",
    "postpack": "echo postpack",
    "publish": "echo publish",
    "postpublish": "echo postpublish",
    "postpublish:subtree": "ts-node ./script/run/postpublish-subtree.ts",
    "postpublishOnly": "pnpm run postpublishOnly:ws-root-changelog & echo postpublishOnly",
    "postpublishOnly:ws-root-changelog": "ynpx ws-root-changelog & git add ./CHANGELOG.md & git commit ./CHANGELOG.md -m \"chore(changelog): update changelog toc in workspaces root\" & echo update changelog toc in workspaces root",
    "postpublishOnly:add": "ts-node ./script/run/postpublish-add.ts",
    "ncu": "pnpm run ncu:ws",
    "ncu:ws": "yarn-tool ncu -u --AA",
    "ncu:root": "yarn-tool ncu -u",
    "sort-package-json": "pnpm run sort-package-json:root && pnpm run sort-package-json:ws",
    "sort-package-json:root": "yarn-tool sort",
    "sort-package-json:ws": "yarn-tool ws sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@bluelovers/conventional-changelog-bluelovers": "^5.0.27",
    "@bluelovers/fast-glob": "^3.0.4",
    "@git-lazy/spawn": "^2.0.3",
    "@git-lazy/subtree": "^2.0.3",
    "benchmark": "^2.1.4",
    "bluebird": "^3.7.2",
    "check-types": "^11.2.3",
    "debug-color2": "^1.3.2",
    "expect": "^30.5.2",
    "expect-print-close-to": "^1.0.12",
    "float-number": "^2.0.2",
    "fs-extra": "^11.4.1",
    "hash-sum": "^2.0.0",
    "is-extends-of": "^2.0.2",
    "jest": "^30.5.2",
    "jest-chain": "^1.1.6",
    "jest-extended": "^7.0.0",
    "jest-matcher-utils": "^30.5.2",
    "jest-num-close-with": "^1.0.19",
    "lib-r-math.js": "<2 >=1.0.94",
    "lodash-es": "^4.18.1",
    "math-random": "^2.0.1",
    "nanoid": "<4 >=3.3.4",
    "num-in-delta": "^1.0.10",
    "random": "<4 >=3.0.6",
    "random-extra": "^5.0.2",
    "seedrandom": "^3.0.5",
    "shortid": "^2.2.17",
    "ts-jest": "^29.4.14",
    "ts-type": "^3.0.18",
    "tslib": "^2.8.1",
    "undici-types": "^8.11.2"
  },
  "devDependencies": {
    "@bluelovers/jest-config": "^1.1.15",
    "@bluelovers/tsconfig": "^2.0.3",
    "@types/benchmark": "^2.1.5",
    "@types/big.js": "^7.0.0",
    "@types/chai": "^5.2.3",
    "@types/check-types": "^11.2.2",
    "@types/core-decorators": "^0.20.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/nanoid": "^2.1.0",
    "@types/node": "^26.6.3",
    "@yarn-tool/require-resolve": "*",
    "@yarn-tool/ws-find-up-paths": "^1.0.22",
    "reliable-random": "^0.0.1"
  }
}
